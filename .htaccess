<IfModule mod_rewrite.c>
    RewriteEngine On

    # Safe fallback if the Laragon Apache alias has not been loaded yet.
    # Keep application files such as .env, vendor, and storage outside the web root.
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
