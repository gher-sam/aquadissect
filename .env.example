APP_NAME=AquaDissect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquadissect
DB_USERNAME=root
DB_PASSWORD=

CLONE_ENABLED=true
CLONE_DB_CONNECTION=sqlite_clone
CLONE_DB_DATABASE=database/database.sqlite
CLONE_DELAY_HOURS=12
CLONE_BATCH_SIZE=500

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
STUDENT_ID_INITIAL_PASSWORD_ENABLED=false
STUDENT_PASSWORD_SETUP_ENABLED=false
STUDENT_SETUP_ENABLED=false
STUDENT_SETUP_DELIVERY_VERIFIED=false
GMAIL_SENDER_CLIENT_ID=
GMAIL_SENDER_CLIENT_SECRET=
GMAIL_SENDER_REDIRECT_URI=
GMAIL_SENDER_EMAIL=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keep disabled until the production Google callback is configured and verified.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aquadissect.com/auth/google/callback

# Server-side guided-clip validation and metadata removal.
AQUADISSECT_FFMPEG_BINARY=ffmpeg
AQUADISSECT_FFPROBE_BINARY=ffprobe
